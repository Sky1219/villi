# Next.js (.env.local) — written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment env — set with `npx convex env set NAME value` (and again with --prod)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Optional: the reviewer is one call per answer, so it can use a stronger model than the agent loop
ANTHROPIC_MODEL_REVIEWER=claude-opus-5-5
# Optional: embeddings (search falls back to Convex full-text search without it)
VOYAGE_API_KEY=
# Optional but recommended: openFDA key (1,000 req/day per IP without it)
OPENFDA_API_KEY=
# "off" disables /demo?as=father|peer
DEMO_MODE=on
# Seconds from "I asked this" to the in-app "Did you get an answer?" nudge (default 3 days). Set 30 for a demo.
NUDGE_DELAY_SECONDS=
